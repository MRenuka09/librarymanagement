<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Water Tax - Gram Panchayat</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<nav class="bg-blue-600 text-white p-4 flex justify-between items-center shadow-md">
    <h1 class="text-2xl font-bold">Gram Panchayat Information System</h1>
    <div>
        <a href="#" class="px-4 hover:underline">Home</a>
        <a href="#" class="px-4 hover:underline">Taxes</a>
        <a href="#" class="px-4 hover:underline">Library</a>
        <a href="#" class="px-4 hover:underline">Contact</a>
    </div>
</nav>

<header class="bg-blue-500 text-white text-center py-10">
    <h2 class="text-3xl font-semibold">Water Tax Management</h2>
    <p class="text-lg mt-2">Check and pay your water tax easily.</p>
</header>

<section class="container mx-auto p-6">
    <div class="bg-white p-6 rounded-lg shadow-lg">
        <h3 class="text-xl font-bold text-gray-700">What is Water Tax?</h3>
        <p class="text-gray-600 mt-2">Water tax is levied for the supply and maintenance of water resources.</p>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-lg mt-6">
        <h3 class="text-xl font-bold text-gray-700">Enter Your Details</h3>
        <p class="text-gray-600 mt-2">Please enter the required details to proceed with the water tax calculation.</p>
        <form id="taxForm" class="mt-4">
            <label class="block text-gray-700">Property ID/Account Number:</label>
            <input type="text" id="property_id" class="w-full p-2 border rounded mb-4" required>

            <label class="block text-gray-700">Property Address:</label>
            <input type="text" id="property_address" class="w-full p-2 border rounded mb-4" required>

            <label class="block text-gray-700">Taxpayer Name:</label>
            <input type="text" id="taxpayer_name" class="w-full p-2 border rounded mb-4" required>

            <label class="block text-gray-700">Annual Rental Value (ARV in INR):</label>
            <input type="number" id="arv" class="w-full p-2 border rounded mb-4" required>

            <label class="block text-gray-700">Monthly Water Consumption (in liters):</label>
            <input type="number" id="water_usage" class="w-full p-2 border rounded mb-4" required>

            <button type="button" onclick="calculateTax()" class="w-full bg-blue-500 text-white p-2 rounded hover:bg-blue-700">
                Calculate Tax
            </button>
        </form>
    </div>

    <div id="taxResult" class="bg-white p-6 rounded-lg shadow-lg mt-6 hidden">
        <h3 class="text-xl font-bold text-gray-700">Calculated Water Tax</h3>
        <p class="text-gray-600 mt-2">Your estimated water tax is:</p>
        <p id="waterTaxAmount" class="text-2xl font-bold text-blue-500 mt-4"></p>
    </div>

    <!-- Pay Now Section (Initially Hidden) -->
    <div id="payNowSection" class="bg-white p-6 rounded-lg shadow-lg mt-6 hidden">
        <h3 class="text-xl font-bold text-gray-700">Pay Your Water Tax</h3>
        <p class="text-gray-600 mt-2">Make timely payments to avoid service disruption.</p>
        <button id="payNowButton" onclick="redirectToPayment()" 
                class="mt-4 w-full bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-700">
            Pay Now
        </button>
    </div>

</section>

<footer class="bg-gray-800 text-white text-center py-4 mt-10">
    <p>© 2025 Gram Panchayat | All Rights Reserved</p>
</footer>

<script>
    let totalTax = 0;

    function calculateTax() {
        let arv = parseFloat(document.getElementById('arv').value);
        let waterUsage = parseFloat(document.getElementById('water_usage').value);

        let waterTaxRate = 0.015; // 1.5% of ARV
        let sewerageTaxRate = 0.055; // 5.5% of ARV

        let waterTax = arv * waterTaxRate;
        let sewerageTax = arv * sewerageTaxRate;

        let consumptionTax = 0;
        if (waterUsage <= 5000) {
            consumptionTax = waterUsage * 4 / 1000;
        } else if (waterUsage <= 10000) {
            consumptionTax = 5000 * 4 / 1000 + (waterUsage - 5000) * 4 / 1000;
        } else if (waterUsage <= 15000) {
            consumptionTax = 10000 * 4 / 1000 + (waterUsage - 10000) * 5 / 1000;
        } else if (waterUsage <= 20000) {
            consumptionTax = 15000 * 5 / 1000 + (waterUsage - 15000) * 6 / 1000;
        } else {
            consumptionTax = 20000 * 6 / 1000 + (waterUsage - 20000) * 7 / 1000;
        }

        totalTax = waterTax + sewerageTax + consumptionTax;
        document.getElementById('waterTaxAmount').innerText = `₹${totalTax.toFixed(2)}`;

        // Show result and Pay Now button
        document.getElementById('taxResult').classList.remove('hidden');
        document.getElementById('payNowSection').classList.remove('hidden');
    }

    function redirectToPayment() {
        let isLoggedIn = localStorage.getItem("userLoggedIn");

        let paymentUrl = `/payment?amount=${encodeURIComponent(totalTax.toFixed(2))}`;

        if (isLoggedIn === "true") {
            window.location.href = paymentUrl;
        } else {
            window.location.href = `/login?redirect=${encodeURIComponent(paymentUrl)}`;
        }
    }
</script>

</body>
</html>
