<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Management System</title>
    <link rel="stylesheet" href="/stylesheets/styles.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #0073e6;
            color: white;
            padding: 15px;
            text-align: center;
            font-size: 24px;
        }
        nav {
            text-align: center;
            padding: 10px;
        }
        nav a {
            text-decoration: none;
            color: white;
            margin: 15px;
            font-size: 18px;
        }
        .book-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            padding: 20px;
            max-width: 1200px;
            margin: auto;
        }
        .book {
            background: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .book img {
            width: 150px;
            height: 200px;
            object-fit: cover;
            border-radius: 5px;
        }
        .book h3 {
            font-size: 18px;
            margin: 10px 0;
        }
        .book p {
            font-size: 14px;
            color: #555;
        }
        .book button {
            background-color: #28a745;
            color: white;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
            width: 100%;
        }
        .book button:hover {
            background-color: #218838;
        }
    </style>
</head>
<body>

<nav class="bg-blue-600 text-white p-4 flex justify-between items-center shadow-md">
    <h1 class="text-2xl font-bold">Gram Panchayat Information System</h1>
    <div>
        <a href="/" class="px-4 hover:underline">Home</a>
        <a href="/" class="px-4 hover:underline">Taxes</a>
        <a href="/library" class="px-4 hover:underline">Library</a>
        <a href="/contact" class="px-4 hover:underline">Contact</a>
        <a href="/cart">🛒 Cart</a>
        <a href="/payment">💳 Payment</a>
    </div>
</nav>


<main>
    <h2 style="text-align:center; margin-top:20px;">📚 Available Books</h2>
    <div class="book-list">

        <div class="book">
            <img src="https://m.media-amazon.com/images/I/71g2ednj0JL._AC_UY327_FMwebp_QL65_.jpg" alt="The Alchemist">
            <h3>The Alchemist</h3>
            <p>Author: Paulo Coelho</p>
            <p>Price: ₹299</p>
            <p>A philosophical novel about following your dreams.</p>
            <button onclick="borrowBook(this)">📖 Borrow</button>
            <button onclick="addToCart('The Alchemist', 299, 'https://m.media-amazon.com/images/I/71g2ednj0JL._AC_UY327_FMwebp_QL65_.jpg')">🛒 Add to Cart</button>
        </div>

        <div class="book">
            <img src="https://m.media-amazon.com/images/I/713jIoMO3UL._AC_UY327_FMwebp_QL65_.jpg" alt="Rich Dad Poor Dad">
            <h3>Atomic Habits</h3>
            <p>Author: James Clear</p>
            <p>Price: ₹420</p>
            <p>A guide to building good habits and breaking bad ones.</p>
            <button onclick="borrowBook(this)">📖 Borrow</button>
            <button onclick="addToCart('Atomic Habits', 420, 'https://m.media-amazon.com/images/I/81bsw6fnUiL._AC_UY327_FMwebp_QL65_.jpg')">🛒 Add to Cart</button>
        </div>

        <div class="book">
            <img src="https://m.media-amazon.com/images/I/71UypkUjStL._AC_UY327_FMwebp_QL65_.jpg" alt="Ikigai">
            <h3>Ikigai</h3>
            <p>Author: Héctor García & Francesc Miralles</p>
            <p>Price: ₹399</p>
            <p>The Japanese secret to a long and happy life.</p>
            <button onclick="borrowBook(this)">📖 Borrow</button>
            <button onclick="addToCart('Ikigai', 399, 'https://m.media-amazon.com/images/I/71UypkUjStL._AC_UY327_FMwebp_QL65_.jpg')">🛒 Add to Cart</button>
        </div>

        <div class="book">
            <img src="https://m.media-amazon.com/images/I/81bsw6fnUiL._AC_UY327_FMwebp_QL65_.jpg" alt="Atomic Habits">
            <h3>Rich Dad Poor Dad</h3>
            <p>Author: Robert Kiyosaki</p>
            <p>Price: ₹375</p>
            <p>A personal finance classic that teaches financial literacy.</p>
            <button onclick="borrowBook(this)">📖 Borrow</button>
            <button onclick="addToCart('Rich Dad Poor Dad', 375, 'https://m.media-amazon.com/images/I/713jIoMO3UL._AC_UY327_FMwebp_QL65_.jpg')">🛒 Add to Cart</button>
        </div>

    </div>
</main>

<script>
    let cart = JSON.parse(localStorage.getItem("cart")) || [];

    function borrowBook(button) {
        button.innerText = "📖 Borrowed";
        button.disabled = true;
    }

    function addToCart(title, price, image) {
        cart.push({ title, price, image });
        localStorage.setItem("cart", JSON.stringify(cart));
        alert(title + " added to cart!");
    }
</script>

<footer class="bg-gray-800 text-white text-center py-4 mt-10">
    <p>© 2025 Gram Panchayat | All Rights Reserved</p>
</footer>

</body>
</html>
